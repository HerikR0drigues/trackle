# Postgres connection (matches docker-compose.yml at repo root)
DATABASE_URL="postgresql://trackle:trackle@localhost:5433/trackle?schema=public"

# Server
PORT=3001

# CORS — comma-separated list of origins allowed; "*" allows all (dev only)
CORS_ORIGIN="http://localhost:3000"

# iTunes Search API (no key required)
ITUNES_BASE_URL="https://itunes.apple.com"
